exports[`Default 1`] = `
- button "Settings"
`;

exports[`General Open 1`] = `
- dialog "Atraxa Superfriends":
  - heading "Atraxa Superfriends" [level=2]
  - paragraph: Deck settings
  - tablist:
    - tab "General" [selected]
    - tab "Categories"
  - tabpanel "General":
    - text: Deck name
    - textbox "Deck name": Atraxa Superfriends
    - button "Save"
    - paragraph: Shown on the deck tile and in exports.
    - text: Deck colors
    - paragraph: Used to clamp flexible mana production stats.
    - group "Deck colors":
      - button "White" [pressed]
      - button "Blue" [pressed]
      - button "Black"
      - button "Red" [pressed]
      - button "Green" [pressed]
    - text: Cover zoom
    - paragraph: How far the tile art is cropped in.
    - slider "Cover zoom": "140"
    - status: 140%
    - text: Removed-card ghosts
    - paragraph: Keep cards visible in their old category after moving them.
    - switch "Removed-card ghosts": "Off"
  - button "Close"
`;
