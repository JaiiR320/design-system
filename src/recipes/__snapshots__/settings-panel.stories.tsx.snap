exports[`Categories Open 1`] = `
- dialog "Atraxa Superfriends":
  - heading "Atraxa Superfriends" [level=2]
  - paragraph: Deck settings
  - tablist:
    - tab "General"
    - tab "Categories" [selected]
  - tabpanel "Categories":
    - text: New category
    - textbox "New category"
    - button "Add"
