exports[`Delete Confirm Test 1`] = `
- region "Version history":
  - heading "Version history" [level=2]
  - paragraph: Launch plan, 2 versions
  - button "Compare"
  - separator
  - text: 1 autosave collapsed
  - separator
  - text: Tighten launch timeline
  - paragraph: Nov 7, 2026, 01:00 AM
  - button "Delete Tighten launch timeline"
  - button "Restore Tighten launch timeline": Restore
  - text: First draft
