exports[`Selection Mode Test 1`] = `
- region "Version history":
  - heading "Version history" [level=2]
  - paragraph: Launch plan, 2 versions
  - button "Exit compare" [pressed]
  - button "Compare selected"
  - separator
  - text: 1 autosave collapsed
  - separator
  - group "Versions to compare":
    - button "2 Tighten launch timeline Nov 7, 2026, 01:00 AM" [pressed]:
      - text: 2 Tighten launch timeline
      - paragraph: Nov 7, 2026, 01:00 AM
    - button "1 First draft Nov 7, 2026, 12:59 AM" [pressed]:
      - text: 1 First draft
      - paragraph: Nov 7, 2026, 12:59 AM
`;
