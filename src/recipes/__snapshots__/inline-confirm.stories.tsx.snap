    - text: Deleting "First draft" cannot be undone.
    - button "Cancel"
    - button "Delete version"
`;

exports[`Restore Confirm Test 1`] = `
- region "Version history":
  - heading "Version history" [level=2]
  - paragraph: Launch plan, 2 versions
  - button "Compare"
  - separator
  - text: 1 autosave collapsed
  - separator
  - text: Tighten launch timeline
  - paragraph: Nov 7, 2026, 01:00 AM
  - button "Delete Tighten launch timeline"
  - button "Restore Tighten launch timeline" [expanded]: Restore
  - alert "Confirm restore Tighten launch timeline":
    - text: Restoring this version will overwrite the current document.
    - button "Cancel"
    - button "Save current"
    - button "Restore"
  - text: First draft
  - paragraph: Nov 7, 2026, 12:59 AM
  - button "Delete First draft"
  - button "Restore First draft": Restore
`;

