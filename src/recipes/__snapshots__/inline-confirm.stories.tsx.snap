exports[`Delete Confirm Revealed 1`] = `
- region "Snapshot history":
  - heading "Snapshot History" [level=2]
  - paragraph: 2 snapshots
  - button "Compare"
  - separator
  - text: 1 unnamed save collapsed
  - separator
  - text: Swap Karn for Birds
  - paragraph: Nov 7, 2026, 01:00 AM
  - button "Delete Swap Karn for Birds"
  - button "Load Swap Karn for Birds": Load
  - text: Initial build
  - paragraph: Nov 7, 2026, 12:59 AM
  - button "Delete Initial build" [expanded]
  - button "Load Initial build": Load
  - alert "Confirm delete Initial build":
    - text: Deleting "Initial build" cannot be undone.
    - button "Cancel"
    - button "Delete Snapshot"
`;

