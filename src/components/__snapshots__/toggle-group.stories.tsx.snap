// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Auth Mode 1`] = `
- group "Authentication mode":
  - button "Sign in" [pressed]
  - button "Sign up"
`;

exports[`Default 1`] = `
- group "Text style":
  - button "Bold" [pressed]
  - button "Italic"
  - button "Underline"
`;

exports[`Disabled Stable Test 1`] = `
- group "Text style":
  - button "Bold" [disabled] [pressed]
  - button "Italic" [disabled]
`;

exports[`Feedback Type 1`] = `
- group "Issue type":
  - button "Bug Report" [pressed]
  - button "Feature Request"
`;

exports[`Multiple Keyboard 1`] = `
- group "Text style":
  - button "Bold" [pressed]
  - button "Italic" [pressed]
  - button "Underline"
`;

exports[`Variants 1`] = `
- text: outline
- group "Outline":
  - button "Bug" [pressed]
  - button "Feature"
- text: accent
- group "Accent":
  - button "Bold" [pressed]
  - button "Italic"
  - button "Underline"
- text: segmented
- group "Segmented":
  - button "Sign in"
  - button "Sign up" [pressed]
- text: segmented, three options
- group "View":
  - button "Day"
  - button "Week" [pressed]
  - button "Month"
- text: custom look (variant=null)
- group "Label colors":
  - button "Amber" [pressed]
  - button "Sky" [pressed]
  - button "Slate" [pressed]
  - button "Red"
  - button "Emerald" [pressed]
- text: outline size=xs
- group "Outline xs":
  - button "Bug" [pressed]
  - button "Feature"
- text: disabled
- group "Disabled":
  - button "Bug" [disabled] [pressed]
  - button "Feature" [disabled]
`;
