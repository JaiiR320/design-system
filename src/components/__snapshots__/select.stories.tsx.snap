// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Default 1`] = `
- combobox "Group documents": Project
`;

exports[`Grouped 1`] = `
- combobox "Location": Launch plan
`;

exports[`Grouped Test 1`] = `
- combobox "Location" [expanded]: Launch plan
- listbox:
  - group "Projects":
    - option "Atlas"
    - option "Borealis"
    - option "Cobalt"
  - group "Documents":
    - option "Quarterly report"
    - option "Design review"
    - option "Launch plan" [selected]
`;

exports[`Keyboard Test 1`] = `
- combobox "Sort documents" [expanded]: Alphabetical
- listbox:
  - option "Last modified"
  - option "Alphabetical" [selected]
  - option "Owner" [disabled]
  - option "Date created"
`;

exports[`Mobile Width Test 1`] = `
- text: Order by
- combobox "Order documents by" [expanded]: Date created
- listbox:
  - option "Date created" [selected]
  - option "Title"
  - option "Size"
`;

exports[`Narrow Trigger Test 1`] = `
- combobox "Order by" [expanded]: Title
- listbox:
  - option "Date created"
  - option "Title" [selected]
  - option "Size"
`;

exports[`Open Test 1`] = `
- combobox "Sort documents" [expanded]: Last modified
- listbox:
  - option "Last modified" [selected]
  - option "Alphabetical"
  - option "Owner" [disabled]
  - option "Date created"
`;

