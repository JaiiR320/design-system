// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Backdrop Closes 1`] = `
- button "New Deck"
`;

exports[`Default 1`] = `
- button "New Deck"
`;

exports[`Divided 1`] = `
- dialog "Export Deck":
  - heading "Export Deck" [level=2]
  - button "Close"
  - paragraph: Plain-text decklist, one card per line.
  - textbox "Decklist": 1 Ajani, Mentor of Heroes 1 Anguished Unmaking 1 Arcane Signet 1 Atraxa, Praetors' Voice 1 Beast Within 1 Birds of Paradise 1 Breeding Pool 1 Chromatic Lantern 1 Command Tower 1 Counterspell
  - button "Cancel"
  - button "Copy to Clipboard"
`;

exports[`Escape Closes 1`] = `
- button "New Deck"
`;

exports[`Footer Layouts 1`] = `
- dialog "Footer layouts":
  - heading "Footer layouts" [level=2]
  - button "Close"
  - button "Cancel"
  - button "Save"
  - button "Cancel"
  - button "Send"
  - button "Back"
  - button "Import"
`;

