{
  "name": "@jaiir320/design-system",
  "version": "0.2.1",
  "private": true,
  "description": "Semantic tokens and composable React primitives on shadcn/ui + Base UI.",
  "license": "MIT",
  "files": [
    "src",
    "!src/**/*.stories.tsx",
    "!src/**/*.test.ts",
    "!src/**/__screenshots__",
    "!src/**/__snapshots__",
    "!src/foundation",
    "!src/recipes"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts"
  },
  "exports": {
    "./styles.css": "./src/styles.css",
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "storybook": "storybook dev -p 6106 --no-open",
    "build-storybook": "storybook build",
    "check": "tsc --noEmit",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "test:update": "vitest run --update",
    "verify": "pnpm fmt:check && pnpm lint && pnpm check && pnpm test && pnpm build-storybook",
    "chromatic": "chromatic --exit-zero-on-changes"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-vitest": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "chromatic": "^18.14.3",
    "lucide-react": "^1.70.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "playwright": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.6",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "lucide-react": "^1",
    "react": "^19",
    "react-dom": "^19"
  },
  "packageManager": "pnpm@10.33.2"
}
